  "testTagPolicies": [
    {
      "tag": "requires-mongo",
      "packages": ["dddart_repository_mongodb"],
      "localAction": "exclude",
      "ciAction": "run",
      "reason": "Local validation does not assume a MongoDB service; CI supplies MongoDB on localhost:27017.",
      "service": {
        "kind": "mongo",
        "host": "127.0.0.1",
        "port": 27017,
        "timeoutSeconds": 60
      }
    },
    {
      "tag": "requires-dynamodb",
      "packages": ["dddart_repository_dynamodb"],
      "localAction": "exclude",
      "ciAction": "run",
      "reason": "Local validation does not assume DynamoDB Local; CI supplies it on localhost:8000.",
      "service": {
        "kind": "dynamodb",
        "host": "127.0.0.1",
        "port": 8000,
        "timeoutSeconds": 60
      }
    },
    {
      "tag": "requires-mysql",
      "packages": ["dddart_repository_mysql"],
      "localAction": "exclude",
      "ciAction": "run",
      "reason": "Local validation does not assume MySQL; CI supplies the documented test database on localhost:3307.",
      "service": {
        "kind": "mysql",
        "host": "127.0.0.1",
        "port": 3307,
        "timeoutSeconds": 90
      },
      "ciEnvironment": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3307",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "test_password",
        "MYSQL_DATABASE": "test_db"
      }
    }
  ]
