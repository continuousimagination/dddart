---
import { doc, sections, navTitles } from '../lib/site';
const { entries, current } = Astro.props;
---
<nav aria-label="Documentation">
  {sections.map(section => <div class="docs-nav-group"><h2>{section}</h2><ul>{entries.filter((entry: any) => entry.data.section === section).map((entry: any) => <li><a href={doc(entry.id)} aria-current={current === entry.id ? 'page' : undefined}>{navTitles[entry.id] ?? entry.data.title}</a></li>)}</ul></div>)}
</nav>
