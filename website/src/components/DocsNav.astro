---
import { navigation } from '../lib/repository-docs';
import { doc } from '../lib/site';
interface Props { current: string; }
const { current } = Astro.props;
---
<nav aria-label="Documentation">
  {Object.entries(navigation).map(([section, entries]) => (
    <div class="docs-nav-group"><h2>{section}</h2><ul>
      {entries.map(guide => <li><a href={doc(guide.slug)} aria-current={current === guide.slug ? 'page' : undefined}>{guide.label}</a></li>)}
    </ul></div>
  ))}
</nav>
