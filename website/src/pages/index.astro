---
import { Code } from 'astro:components';
import Base from '../layouts/Base.astro';
import { doc } from '../lib/site';
import '../styles/home.css';
import modelExample from '../../../docs/quickstarts/core/bin/main.dart?raw';
import repositoryExample from '../../../docs/quickstarts/core/bin/repository.dart?raw';
import serviceExample from '../../../docs/quickstarts/core/bin/contracts.dart?raw';

const examples = [
  { id: 'order', title: 'Place an order', file: 'main.dart', guide: 'getting-started', link: 'Run the order example', code: modelExample },
  { id: 'repository', title: 'Store a note', file: 'repository.dart', guide: 'repositories', link: 'Run the repository example', code: repositoryExample },
  { id: 'service', title: 'Confirm a reservation', file: 'contracts.dart', guide: 'contracts', link: 'Run the service example', code: serviceExample },
];
const guides = [
  { slug: 'modeling', title: 'Model a business rule', text: 'Give a reservation a valid seat count and control when it can be confirmed.' },
  { slug: 'repositories', title: 'Keep data between runs', text: 'Move from an in-memory repository to a database that fits your app.' },
  { slug: 'http', title: 'Expose a model over HTTP', text: 'Serve a public resource and choose which operations require a signed-in caller.' },
];
---
<Base title="dddart" description="Learn domain-driven design in Dart. Model an order, save it through a repository, and react to its domain event." home>
  <main id="main-content">
    <section class="hero">
      <div class="hero-inner">
        <div>
          <h1>Domain-driven design<br /><span>in Dart.</span></h1>
          <p class="hero-description">An order can be placed once. Where does that rule belong?</p>
          <p class="hero-detail">Put it in the order itself. In your first DDDart program, you’ll place an order, save it in memory, and listen for the event it raises. All you need is Dart.</p>
          <div class="button-row">
            <a class="button button-lime" href={doc('getting-started')}>Build your first model <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={doc('philosophy')}>Why model the domain?</a>
          </div>
        </div>
        <div class="code-window">
          <div class="code-tabs" role="tablist" aria-label="Dart examples">
            {examples.map((example, i) => (
              <button id={`tab-${example.id}`} role="tab" aria-selected={i === 0} aria-controls={`panel-${example.id}`} tabindex={i === 0 ? 0 : -1} data-code-tab>{example.title}</button>
            ))}
          </div>
          {examples.map((example, i) => (
            <div role="tabpanel" id={`panel-${example.id}`} aria-labelledby={`tab-${example.id}`} hidden={i !== 0}>
              <p class="code-filename">{example.file}</p>
              <Code code={example.code} lang="dart" theme="github-dark" />
              <a class="code-caption" href={doc(example.guide)}>{example.link} <span aria-hidden="true">→</span></a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="learning section-inner" aria-labelledby="guides-heading">
      <h2 id="guides-heading">What are you building?</h2>
      <div class="learning-grid">
        {guides.map(guide => (
          <a href={doc(guide.slug)}><h3>{guide.title} <span aria-hidden="true">↗</span></h3><p>{guide.text}</p></a>
        ))}
      </div>
      <p class="catalog-link">Working with a particular adapter? <a href={doc('packages')}>Find its guide</a>.</p>
    </section>
  </main>
</Base>
