---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocsNav from '../../components/DocsNav.astro';
import { doc, sections, repo } from '../../lib/site';
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const entries = (await getCollection('docs')).sort((a, b) => sections.indexOf(a.data.section) - sections.indexOf(b.data.section) || a.data.order - b.data.order);
const current = entries.findIndex(item => item.id === entry.id);
const previous = entries[current - 1];
const next = entries[current + 1];
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="docs-shell">
    <aside class="docs-sidebar"><p class="sidebar-label">THE DDDART FIELD GUIDE</p><DocsNav entries={entries} current={entry.id} /><a class="sidebar-note" href={doc('getting-started')}>Pre-release · Install from Git <span>Start with a pinned revision ↗</span></a></aside>
    <main id="main-content" class="doc-main">
      <details class="mobile-doc-nav"><summary>Browse documentation</summary><DocsNav entries={entries} current={entry.id} /></details>
      <div class="doc-heading"><p class="eyebrow">{entry.data.section}</p><h1>{entry.data.title}</h1><p class="doc-description">{entry.data.description}</p></div>
      <article class="prose"><Content /></article>
      <div class="doc-edit"><a href={`${repo}/edit/main/website/src/content/docs/${entry.id}.md`}>Improve this page ↗</a><span>Written against the current pre-release API</span></div>
      <nav class="doc-pagination" aria-label="Next and previous pages">{previous ? <a href={doc(previous.id)}><span>← Previous</span>{previous.data.title}</a> : <div />}{next && <a href={doc(next.id)}><span>Next →</span>{next.data.title}</a>}</nav>
    </main>
    <aside class="docs-toc"><nav aria-label="On this page"><p class="sidebar-label">ON THIS PAGE</p><ul>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav><a class="toc-cta" href={doc('examples')}>Learn by building <span>Explore the examples ↗</span></a></aside>
  </div>
</Base>
